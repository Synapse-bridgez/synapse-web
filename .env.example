# Synapse Core — environment
#
# Copy to `.env.local`. Every value here is optional except the contract id if
# you want live data instead of the mock fallback in `lib/mock-data.ts`.

# ── Contract / network ────────────────────────────────────────────────────────

# The deployed contract to read and write. Without it the dashboard and the
# transaction list fall back to mock data.
NEXT_PUBLIC_CONTRACT_ID=

# Optional. Defaults to the public testnet RPC.
NEXT_PUBLIC_SOROBAN_RPC_URL=

# ── Origin allowlist (anti-phishing) ──────────────────────────────────────────
#
# These drive the origin badge in the header and the note above every signing
# action. An origin that is not on this list renders as UNVERIFIED, which is
# intentional: the badge is meant to be unforgiving rather than reassuring.
# See "Verifying you're on the real dashboard" in README.md.

# The published address of this deployment.
NEXT_PUBLIC_SITE_URL=https://synapse.example.com

# Any further published origins (custom domain, alias, alternate host), comma- or
# space-separated. Scheme-less hostnames are treated as https://.
# NEXT_PUBLIC_CANONICAL_ORIGINS=https://alt.example.com, https://synapse.example.com

# NOTE: VERCEL_URL is supplied automatically by Vercel at build time and needs
# no entry here. Do not rename it to NEXT_PUBLIC_VERCEL_URL — that is a
# different, unset variable, and reading it leaves every Vercel preview
# deployment permanently UNVERIFIED.

# Localhost and its loopback aliases always classify as LOCAL DEV, even when
# listed above, so a local server can never display a trusted badge.
